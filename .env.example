# Use the exact GraphQL endpoint, or the WebGUI origin (which adds /graphql).
UNRAID_URL=https://tower.local
UNRAID_API_KEY=replace-with-an-unraid-api-key

# Optional TLS configuration. Prefer a trusted CA over disabling verification.
# UNRAID_CA_CERT_PATH=/absolute/path/to/unraid-ca.pem
# UNRAID_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# UNRAID_TLS_SKIP_VERIFY=false

# Mutating tools are not registered unless this is true.
UNRAID_ALLOW_MUTATIONS=false

# Requires UNRAID_ALLOW_MUTATIONS=true. Enables permanent/high-risk tools.
UNRAID_ALLOW_DESTRUCTIVE_MUTATIONS=false

# Optional request limits.
UNRAID_REQUEST_TIMEOUT_MS=15000
UNRAID_MAX_RESPONSE_BYTES=5242880

# MCP transport. stdio is the default. For a remote container, use http.
MCP_TRANSPORT=stdio
# MCP_HOST=0.0.0.0
# MCP_PORT=3000
# MCP_ALLOWED_HOSTS=mcp-server.example,192.168.1.20

# HTTP bearer authentication. If omitted in HTTP mode, a random token is
# generated at startup and printed to stderr/container logs.
# MCP_AUTH_TOKEN=replace-with-at-least-32-random-bytes

# Browser Origin headers are rejected unless their hostnames are listed here.
# Normal MCP clients do not send Origin.
# MCP_ALLOWED_ORIGINS=trusted-app.local

# Optional HTTP security limits.
# MCP_AUTH_FAILURE_LIMIT=10
# MCP_AUTH_FAILURE_WINDOW_MS=60000
# MCP_MAX_REQUEST_BYTES=1048576
# MCP_HTTP_REQUEST_TIMEOUT_MS=30000
